#!/bin/bash
# appi - минимальный менеджер AppImage
#
#   appi add <src[@версия]> [имя] [-a алиас,...]  установить (URL или GitHub releases)
#   appi ls                          список установленных, версий и алиасов
#   appi up [имя ...]                обновить (закреплённые версии не трогает)
#   appi rm <имя>                    удалить приложение, алиасы и интеграцию
#   appi run <имя> [args]            запустить
#   appi info <имя>                  показать метаданные
#   appi alias <имя> [алиас ...]     добавить алиасы (без аргументов - показать)
#   appi unalias <алиас ...>         убрать алиасы
#   appi shellrc                     строка для .zshrc/.bashrc (shell-алиасы)
#   appi relink                      пересобрать все симлинки и aliases.sh
#   appi versions <src|имя> [N]      последние N релизов GitHub (по умолчанию 10)
#   appi pick <src|имя> [имя] [-N n] выбрать версию из списка и поставить её
#   appi pin <имя> <версия|latest>   закрепить/открепить версию
#   appi sync [файл] [-n|-u|-p]      привести систему к списку (декларативный режим)
#   appi export [файл]               выгрузить текущее состояние в такой список
#
# Флаги sync: -n/--dry-run — только показать план, -u/--update — ещё и обновить,
# -p/--prune — удалить всё, чего нет в списке.
#
# Версии (только для источников вида user/repo):
#   user/repo          всегда последний релиз, appi up обновляет
#   user/repo@v1.2.3   закреплённый тег, appi up его не трогает
#   appi versions user/repo    посмотреть последние релизы
#   appi pick user/repo        выбрать версию из списка (интерактивно)
#   $GITHUB_TOKEN, если задан, используется для запросов к API.
#
# Формат списка ($APPI_LIST, по умолчанию ~/.local/packages/appimages):
#   # имя      источник (user/repo[@версия] или URL)   алиасы,через,запятую
#   obsidian    ivan-hc/Obsidian                        ob,notes
#   freecad     FreeCAD/FreeCAD@1.0.0                   cad
#   пустые строки и # — комментарии; можно указать только источник — имя выведётся само
#
# Запускать программы можно тремя способами: по имени (симлинк в ~/.local/bin),
# по любому алиасу (такой же симлинк) или через shell-алиасы из aliases.sh.
#
# Раскладка:
#   $APPI_DIR (~/.local/opt/appimages)   сами .AppImage и .meta файлы
#   ~/.local/bin/<имя|алиас>             симлинки для запуска из шелла
#   ~/.local/share/appi/aliases.sh       сгенерированные shell-алиасы
#   ~/.local/share/applications          .desktop, извлечённый из AppImage
#   ~/.local/share/icons/hicolor/...     иконка приложения

set -euo pipefail
shopt -s extglob nullglob

APPI_DIR="${APPI_DIR:-$HOME/.local/opt/appimages}"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
APP_DIR="$HOME/.local/share/applications"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
ALIAS_FILE="${APPI_ALIAS_FILE:-$HOME/.local/share/appi/aliases.sh}"
APPI_LIST="${APPI_LIST:-$HOME/.local/packages/appimages}"
ARCH="$(uname -m)"

die() { printf '%s\n' "appi: $*" >&2; exit 1; }
msg() { printf '==> %s\n' "$*"; }

need() { command -v "$1" >/dev/null || die "нужна утилита $1"; }

# --- вспомогательное ------------------------------------------------------

meta_get() { # meta_get <имя> <ключ>
    local f="$APPI_DIR/$1.meta"
    [[ -f "$f" ]] || return 1
    sed -n "s/^$2=//p" "$f"
}

meta_set() { # meta_set <имя> <ключ> <значение>
    local f="$APPI_DIR/$1.meta"
    [[ -f "$f" ]] || die "нет метаданных для '$1'"
    if grep -q "^$2=" "$f"; then
        sed -i "s|^$2=.*|$2=$3|" "$f"
    else
        printf '%s=%s\n' "$2" "$3" >> "$f"
    fi
}

resolve() { # имя -> путь к AppImage
    local p="$APPI_DIR/$1.AppImage"
    [[ -f "$p" ]] || die "приложение '$1' не установлено"
    printf '%s\n' "$p"
}

# --- алиасы ---------------------------------------------------------------

# Симлинк в ~/.local/bin, но никогда не затираем чужие файлы
link_bin() { # link_bin <ссылка> <цель>
    local link="$BIN_DIR/$1" target="$2"
    mkdir -p "$BIN_DIR"
    if [[ -e "$link" && ! -L "$link" ]]; then
        die "'$1' уже существует в $BIN_DIR и это не симлинк"
    fi
    if [[ -L "$link" ]]; then
        local cur; cur=$(readlink -f "$link" || true)
        [[ "$cur" == "$APPI_DIR"/* ]] || die "'$1' занят симлинком не из appi ($cur)"
    fi
    ln -sfn "$target" "$link"
}

unlink_bin() { # unlink_bin <ссылка>: удаляем только свои симлинки
    local link="$BIN_DIR/$1" cur
    [[ -L "$link" ]] || return 0
    cur=$(readlink -f "$link" || true)
    [[ "$cur" == "$APPI_DIR"/* ]] && rm -f "$link"
    return 0
}

aliases_of() { meta_get "$1" aliases 2>/dev/null || true; }

owner_of_alias() { # owner_of_alias <алиас> -> имя приложения
    local f name a
    for f in "$APPI_DIR"/*.meta; do
        name=$(basename "$f" .meta)
        for a in $(aliases_of "$name"); do
            [[ "$a" == "$1" ]] && { printf '%s\n' "$name"; return 0; }
        done
    done
    return 1
}

# Файл с shell-алиасами: пригодится, если ~/.local/bin нет в PATH
gen_alias_file() {
    mkdir -p "$(dirname "$ALIAS_FILE")"
    { echo "# сгенерировано appi, не редактировать вручную"
      local f name a
      for f in "$APPI_DIR"/*.AppImage; do
          name=$(basename "$f" .AppImage)
          printf "alias %s='%s'\n" "$name" "$f"
          for a in $(aliases_of "$name"); do
              printf "alias %s='%s'\n" "$a" "$f"
          done
      done
    } > "$ALIAS_FILE"
}

alias_add() { # alias_add <имя> <алиас ...>
    local name="$1"; shift
    local img; img=$(resolve "$name")
    local cur; cur=$(aliases_of "$name")
    local a owner
    for a in "$@"; do
        [[ "$a" =~ ^[A-Za-z0-9._+-]+$ ]] || die "недопустимый алиас '$a'"
        [[ "$a" == "$name" ]] && { msg "'$a' - это само имя приложения, пропуск"; continue; }
        [[ -f "$APPI_DIR/$a.AppImage" ]] && die "'$a' - имя другого приложения"
        owner=$(owner_of_alias "$a" || true)
        [[ -n "$owner" && "$owner" != "$name" ]] && die "алиас '$a' занят приложением '$owner'"
        link_bin "$a" "$img"
        [[ " $cur " == *" $a "* ]] || cur="${cur:+$cur }$a"
        msg "алиас $a -> $name"
    done
    meta_set "$name" aliases "$cur"
    gen_alias_file
}

alias_del() { # alias_del <алиас ...>
    local a name cur new x
    for a in "$@"; do
        name=$(owner_of_alias "$a" || true)
        [[ -n "$name" ]] || { msg "алиас '$a' не найден"; continue; }
        cur=$(aliases_of "$name"); new=""
        for x in $cur; do [[ "$x" == "$a" ]] || new="${new:+$new }$x"; done
        unlink_bin "$a"
        meta_set "$name" aliases "$new"
        msg "алиас $a убран (был у $name)"
    done
    gen_alias_file
}

# Имя по источнику: user/repo -> repo, URL -> имя файла без версии
derive_name() {
    local src="$1" n
    if [[ "$src" == http?(s)://* ]]; then
        n=$(basename "${src%%\?*}")
        n="${n%.AppImage}"; n="${n%.appimage}"
        n=$(printf '%s\n' "$n" | sed 's/[-_.]\?[0-9][0-9.]*.*$//;s/[^A-Za-z0-9+-]/-/g')
    else
        n="${src#*/}"; n="${n%@*}"; n="${n%.AppImage}"
    fi
    [[ -n "$n" ]] || die "не смог вывести имя из '$src'"
    printf '%s\n' "${n,,}"
}

# --- GitHub releases ------------------------------------------------------

GH_API="${GH_API:-https://api.github.com}"

gh_get() { # gh_get <path>
    need curl
    local auth=()
    [[ -n "${GITHUB_TOKEN:-}" ]] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
    curl -fsL "${auth[@]}" -H 'Accept: application/vnd.github+json' "$GH_API/$1" 2>/dev/null
}

# Значения строкового поля JSON по порядку (JSON на stdin)
json_field() { grep -o "\"$1\": *\"[^\"]*\"" | sed "s/^\"$1\": *\"//;s/\"$//"; }

# "user/repo@v1.2" -> SRC_REPO / SRC_PIN ("latest", если версия не указана)
split_src() {
    SRC_REPO="${1%@*}"
    SRC_PIN="latest"
    [[ "$1" == *@* ]] && SRC_PIN="${1##*@}"
    [[ -n "$SRC_PIN" ]] || SRC_PIN="latest"
}

# asset под текущую архитектуру из JSON одного релиза
gh_asset() {
    local urls
    urls=$(printf '%s' "$1" | json_field browser_download_url | grep -i '\.appimage$' || true)
    [[ -n "$urls" ]] || return 1
    printf '%s\n' "$urls" | grep -i -- "$ARCH" | head -n1 && return 0
    printf '%s\n' "$urls" | head -n1
}

# gh_release <user/repo> [версия] -> "<тег>\t<url>"
gh_release() {
    local repo="$1" tag="${2:-latest}" json path t url
    if [[ "$tag" == latest ]]; then path="repos/$repo/releases/latest"
    else                            path="repos/$repo/releases/tags/$tag"; fi
    json=$(gh_get "$path") || return 1
    [[ -n "$json" ]] || return 1
    t=$(printf '%s' "$json" | json_field tag_name | head -n1)
    url=$(gh_asset "$json") || return 1
    printf '%s\t%s\n' "${t:-$tag}" "$url"
}

# gh_versions <user/repo> [N] -> "<тег>\t<дата>\t<pre|->" от новых к старым
gh_versions() {
    local repo="$1" n="${2:-10}" json i
    json=$(gh_get "repos/$repo/releases?per_page=$n") || return 1
    local -a tags dates pres
    mapfile -t tags  < <(printf '%s' "$json" | json_field tag_name)
    mapfile -t dates < <(printf '%s' "$json" | grep -o '"published_at":[^,]*' | sed 's/^"published_at": *//;s/"//g')
    mapfile -t pres  < <(printf '%s' "$json" | grep -o '"prerelease": *[a-z]*' | sed 's/.*: *//')
    [[ ${#tags[@]} -gt 0 ]] || return 1
    for ((i = 0; i < ${#tags[@]}; i++)); do
        printf '%s\t%s\t%s\n' "${tags[i]}" "${dates[i]:0:10}" \
            "$([[ "${pres[i]:-false}" == true ]] && echo pre || echo -)"
    done
}

# Скачать AppImage в <target> с проверкой, что это исполняемый ELF
fetch_appimage() { # fetch_appimage <url> <target>
    curl -fL --progress-bar -o "$2.part" "$1" || { rm -f "$2.part"; return 1; }
    head -c4 "$2.part" | grep -q 'ELF' || { rm -f "$2.part"; msg "$(basename "$2"): скачанный файл не похож на AppImage"; return 1; }
    mv "$2.part" "$2"
    chmod +x "$2"
}

# Поставить конкретную версию поверх установленной
switch_version() { # switch_version <имя> <версия|latest>
    local name="$1" want="$2" repo img t url cur
    repo=$(meta_get "$name" repo || true)
    [[ -n "$repo" ]] || die "$name: источник не GitHub-репозиторий, версии недоступны"
    IFS=$'\t' read -r t url < <(gh_release "$repo" "$want") \
        || die "$name: релиз '$want' не найден в $repo (appi versions $name)"
    img="$APPI_DIR/$name.AppImage"
    cur=$(meta_get "$name" version || true)
    msg "$name: ${cur:-?} -> $t"
    fetch_appimage "$url" "$img" || die "$name: не удалось скачать $t"
    meta_set "$name" version "$t"
    meta_set "$name" url "$url"
    meta_set "$name" sha256 "$(sha256sum "$img" | cut -d' ' -f1)"
    integrate "$name"
    link_bin "$name" "$img"
}

# Интеграция в меню: распаковываем .desktop и иконку из самого AppImage
integrate() { # integrate <имя>: .desktop и иконка из самого AppImage -> ~/.local/share
    local name="$1" img="$APPI_DIR/$1.AppImage" tmp rc=0
    tmp=$(mktemp -d)
    ( cd "$tmp" && integrate_inner "$name" "$img" "$tmp" ) || rc=$?
    rm -rf "$tmp"
    return "$rc"
}

integrate_inner() {
    local name="$1" img="$2" tmp="$3" desktop icon icon_name pat

    "$img" --appimage-extract '*.desktop' >/dev/null 2>&1 || true
    desktop=$(find "$tmp/squashfs-root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -n1)
    [[ -n "$desktop" ]] || { msg "$name: .desktop не найден, интеграция пропущена"; return 0; }

    icon_name=$(sed -n 's/^Icon=//p' "$desktop" | head -n1)
    for pat in "$icon_name.png" ".DirIcon" "usr/share/icons/*"; do
        [[ -n "$pat" ]] && "$img" --appimage-extract "$pat" >/dev/null 2>&1 || true
    done
    # самый крупный настоящий файл (битые симлинки отбрасываются -type f)
    icon=$(find "$tmp/squashfs-root" \( -name "${icon_name:-icon}.png" -o -name '.DirIcon' \) \
           -type f -printf '%s %p\n' 2>/dev/null | sort -n | tail -n1 | cut -d' ' -f2-)
    if [[ -n "$icon" && -f "$icon" ]]; then
        mkdir -p "$ICON_DIR"
        cp -Lf "$icon" "$ICON_DIR/appi-$name.png"
        icon_name="appi-$name"
    fi

    mkdir -p "$APP_DIR"
    sed -e "s|^Exec=[^ ]*|Exec=$img|" \
        -e "s|^TryExec=.*|TryExec=$img|" \
        -e "s|^Icon=.*|Icon=${icon_name:-application-x-executable}|" \
        "$desktop" > "$APP_DIR/appi-$name.desktop"
    command -v update-desktop-database >/dev/null && \
        update-desktop-database "$APP_DIR" >/dev/null 2>&1 || true
    return 0
}

# --- команды --------------------------------------------------------------

cmd_add() {
    local src="" name="" url arg new_aliases="" repo="" pin="-" ver=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--alias) new_aliases="${new_aliases:+$new_aliases }${2//,/ }"; shift 2 ;;
            -a=*|--alias=*) arg="${1#*=}"; new_aliases="${new_aliases:+$new_aliases }${arg//,/ }"; shift ;;
            -*) die "неизвестный флаг '$1'" ;;
            *) if [[ -z "$src" ]]; then src="$1"; elif [[ -z "$name" ]]; then name="$1"; else die "лишний аргумент '$1'"; fi; shift ;;
        esac
    done
    [[ -n "$src" ]] || die "укажите URL или user/repo[@версия]"
    need curl

    if [[ "$src" == http?(s)://* ]]; then
        url="$src"
    elif [[ "$src" == */* ]]; then
        split_src "$src"
        repo="$SRC_REPO"; pin="$SRC_PIN"
        IFS=$'\t' read -r ver url < <(gh_release "$repo" "$pin") \
            || die "в релизе '$pin' репозитория '$repo' нет AppImage или он недоступен (appi versions $repo)"
        [[ -n "$url" ]] || die "не нашёл AppImage для '$repo'"
        [[ -n "$name" ]] || name="${repo#*/}"
    else
        die "не понял источник '$src'"
    fi

    [[ -n "$name" ]] || name=$(derive_name "$url")

    mkdir -p "$APPI_DIR" "$BIN_DIR"
    local target="$APPI_DIR/$name.AppImage"
    [[ -e "$target" ]] && die "'$name' уже установлен (appi up $name / appi pin $name <версия> / appi rm $name)"

    msg "загружаю $name${ver:+ $ver} из $url"
    fetch_appimage "$url" "$target" || die "не удалось скачать $name"

    { echo "name=$name"; echo "url=$url"; echo "source=$src"
      echo "repo=$repo"; echo "pin=$pin"; echo "version=$ver"
      echo "installed=$(date -Is)"
      echo "sha256=$(sha256sum "$target" | cut -d' ' -f1)"; } > "$APPI_DIR/$name.meta"

    link_bin "$name" "$target"
    integrate "$name"
    # shellcheck disable=SC2086
    [[ -n "$new_aliases" ]] && alias_add "$name" $new_aliases || gen_alias_file
    msg "готово: $name${ver:+ ($ver)}$([[ "$pin" != latest && "$pin" != - ]] && printf ', версия закреплена')"
}

cmd_ls() {
    [[ -d "$APPI_DIR" ]] || { msg "ничего не установлено"; return 0; }
    shopt -s nullglob
    local f name size al ver pin
    {
        printf 'ИМЯ\tВЕРСИЯ\tРАЗМЕР\tАЛИАСЫ\tИСТОЧНИК\n'
        for f in "$APPI_DIR"/*.AppImage; do
            name=$(basename "$f" .AppImage)
            size=$(du -h "$f" | cut -f1)
            al=$(aliases_of "$name" | tr ' ' ',')
            ver=$(meta_get "$name" version 2>/dev/null || echo -)
            pin=$(meta_get "$name" pin 2>/dev/null || echo -)
            [[ "$pin" != latest && "$pin" != - && -n "$pin" ]] && ver="${ver} (pin)"
            printf '%s\t%s\t%s\t%s\t%s\n' "$name" "${ver:--}" "$size" "${al:--}" \
                "$(meta_get "$name" source || echo -)"
        done
    } | { command -v column >/dev/null && column -t -s $'\t' || cat; }
}

cmd_up() {
    shopt -s nullglob
    local names=("$@") f
    if [[ ${#names[@]} -eq 0 ]]; then
        for f in "$APPI_DIR"/*.AppImage; do names+=("$(basename "$f" .AppImage)"); done
    fi
    local name img old url new repo pin cur tag
    for name in "${names[@]}"; do
        img=$(resolve "$name")
        migrate_meta "$name" || true
        repo=$(meta_get "$name" repo || true)
        pin=$(meta_get "$name" pin || echo latest)
        cur=$(meta_get "$name" version || true)

        # 0) закреплённая версия: обновлять нечего
        if [[ -n "$repo" && -n "$pin" && "$pin" != latest && "$pin" != - ]]; then
            if [[ "$cur" == "$pin" ]]; then
                msg "$name: закреплён на $pin (appi pin $name latest — открепить)"
            else
                ( switch_version "$name" "$pin" ) || msg "$name: не смог поставить $pin, пропуск"
            fi
            continue
        fi

        # 1) GitHub-репозиторий: сравниваем теги релизов
        if [[ -n "$repo" ]]; then
            if ! IFS=$'\t' read -r tag url < <(gh_release "$repo" latest); then
                msg "$name: нет AppImage в релизах $repo, пропуск"; continue
            fi
            if [[ -n "$cur" && "$tag" == "$cur" ]]; then
                msg "$name: уже последняя версия ($tag)"; continue
            fi
            if ( switch_version "$name" "$tag" ); then
                msg "$name: обновлён до $tag"
            else
                msg "$name: обновление не удалось, пропуск"
            fi
            continue
        fi

        old=$(sha256sum "$img" | cut -d' ' -f1)

        # 2) штатный механизм AppImage: zsync-обновление по встроенной инфе
        if "$img" --appimage-updateinformation >/dev/null 2>&1 && \
           [[ -n "$("$img" --appimage-updateinformation 2>/dev/null)" ]] && \
           command -v appimageupdatetool >/dev/null; then
            msg "$name: zsync-обновление"
            appimageupdatetool -O "$img" && continue
        fi

        # 3) иначе перекачиваем по сохранённому URL
        url=$(meta_get "$name" url || true)
        [[ -n "$url" ]] || { msg "$name: источник неизвестен, пропуск"; continue; }
        msg "$name: проверяю $url"
        curl -fL --progress-bar -o "$img.part" "$url"
        new=$(sha256sum "$img.part" | cut -d' ' -f1)
        if [[ "$new" == "$old" ]]; then
            rm -f "$img.part"; msg "$name: уже последняя версия"; continue
        fi
        mv "$img.part" "$img"; chmod +x "$img"
        meta_set "$name" sha256 "$new"
        integrate "$name"
        msg "$name: обновлён"
    done
}

cmd_rm() {
    local name="${1:-}"; [[ -n "$name" ]] || die "укажите имя"
    resolve "$name" >/dev/null
    local a
    for a in $(aliases_of "$name"); do unlink_bin "$a"; done
    unlink_bin "$name"
    rm -f "$APPI_DIR/$name.AppImage" "$APPI_DIR/$name.meta" \
          "$APP_DIR/appi-$name.desktop" "$ICON_DIR/appi-$name.png"
    gen_alias_file
    msg "$name удалён"
}

cmd_run() {
    local name="${1:-}"; shift || true
    [[ -n "$name" ]] || die "укажите имя или алиас"
    # приняли и имя, и алиас
    [[ -f "$APPI_DIR/$name.AppImage" ]] || name=$(owner_of_alias "$name" || printf '%s' "$name")
    exec "$(resolve "$name")" "$@"
}

cmd_alias() {
    local name="${1:-}"; shift || true
    [[ -n "$name" ]] || die "использование: appi alias <имя> [алиас ...]"
    resolve "$name" >/dev/null
    if [[ $# -eq 0 ]]; then
        printf '%s\n' "$(aliases_of "$name" | tr ' ' '\n')"
        return 0
    fi
    alias_add "$name" "$@"
}

cmd_unalias() {
    [[ $# -gt 0 ]] || die "использование: appi unalias <алиас ...>"
    alias_del "$@"
}

cmd_shellrc() {
    gen_alias_file
    printf '[ -f %s ] && . %s\n' "$ALIAS_FILE" "$ALIAS_FILE"
}

relink_all() { # восстановить все симлинки и файл алиасов (после deploy/переноса)
    local f name a
    for f in "$APPI_DIR"/*.AppImage; do
        name=$(basename "$f" .AppImage)
        link_bin "$name" "$f"
        for a in $(aliases_of "$name"); do link_bin "$a" "$f"; done
    done
    gen_alias_file
}

cmd_relink() {
    relink_all
    msg "симлинки и $ALIAS_FILE обновлены"
}

# --- версии ---------------------------------------------------------------

# Старые .meta (до появления версий) не знают про repo/pin — выводим из source
migrate_meta() { # migrate_meta <имя>
    local name="$1" src repo
    repo=$(meta_get "$name" repo 2>/dev/null || true)
    [[ -z "$repo" ]] || return 0
    src=$(meta_get "$name" source 2>/dev/null || true)
    [[ -n "$src" && "$src" != http?(s)://* && "$src" == */* ]] || return 0
    split_src "$src"
    meta_set "$name" repo "$SRC_REPO"
    meta_set "$name" pin "$SRC_PIN"
}

# Определить репозиторий по аргументу: user/repo[@версия] или имя установленного
resolve_repo() { # resolve_repo <src|имя> -> repo (в REPO_PIN — версия из аргумента)
    local what="$1"
    REPO_PIN=""
    if [[ "$what" == */* && "$what" != http?(s)://* ]]; then
        split_src "$what"
        REPO_PIN="$SRC_PIN"
        printf '%s\n' "$SRC_REPO"
        return 0
    fi
    migrate_meta "$what" 2>/dev/null || true
    local repo; repo=$(meta_get "$what" repo 2>/dev/null || true)
    [[ -n "$repo" ]] || die "'$what': не установлен или источник не GitHub-репозиторий"
    printf '%s\n' "$repo"
}

# Таблица релизов; при известном приложении помечает установленную/закреплённую
print_versions() { # print_versions <repo> <N> [имя]
    local repo="$1" n="$2" name="${3:-}" list cur="" pin="" i=0 tag date pre mark
    list=$(gh_versions "$repo" "$n") || die "не смог получить релизы $repo (лимит API? задайте GITHUB_TOKEN)"
    if [[ -n "$name" ]]; then
        cur=$(meta_get "$name" version 2>/dev/null || true)
        pin=$(meta_get "$name" pin 2>/dev/null || true)
    fi
    {
        printf '#\tВЕРСИЯ\tДАТА\tПРИМЕЧАНИЕ\n'
        while IFS=$'\t' read -r tag date pre; do
            i=$((i + 1)); mark=""
            [[ -n "$cur" && "$tag" == "$cur" ]] && mark="установлена"
            [[ -n "$pin" && "$pin" != latest && "$pin" != - && "$tag" == "$pin" ]] && mark="${mark:+$mark, }закреплена"
            [[ "$pre" == pre ]] && mark="${mark:+$mark, }pre-release"
            printf '%s\t%s\t%s\t%s\n' "$i" "$tag" "$date" "${mark:--}"
        done < <(printf '%s\n' "$list")
    } | { command -v column >/dev/null && column -t -s $'\t' || cat; }
}

cmd_versions() {
    local what="${1:-}" n="${2:-10}" repo name=""
    [[ -n "$what" ]] || die "использование: appi versions <user/repo|имя> [сколько]"
    repo=$(resolve_repo "$what")
    [[ "$what" == */* ]] || name="$what"
    print_versions "$repo" "$n" "$name"
}

cmd_pick() {
    local what="" name="" n=10 new_aliases="" arg repo tag list ans
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--alias) new_aliases="${new_aliases:+$new_aliases }${2//,/ }"; shift 2 ;;
            -a=*|--alias=*) arg="${1#*=}"; new_aliases="${new_aliases:+$new_aliases }${arg//,/ }"; shift ;;
            -N|--count) n="$2"; shift 2 ;;
            -N=*|--count=*) n="${1#*=}"; shift ;;
            -*) die "неизвестный флаг '$1'" ;;
            *) if [[ -z "$what" ]]; then what="$1"; elif [[ -z "$name" ]]; then name="$1"; else die "лишний аргумент '$1'"; fi; shift ;;
        esac
    done
    [[ -n "$what" ]] || die "использование: appi pick <user/repo|имя> [имя] [-N сколько] [-a алиас,...]"
    repo=$(resolve_repo "$what")
    [[ -n "$name" ]] || { [[ "$what" == */* ]] && name="${repo#*/}" || name="$what"; }

    print_versions "$repo" "$n" "$([[ -f "$APPI_DIR/$name.AppImage" ]] && printf '%s' "$name")"
    list=$(gh_versions "$repo" "$n")
    read -r -p "номер версии [1, q — отмена]: " ans || true
    ans="${ans:-1}"
    [[ "$ans" == q ]] && { msg "отменено"; return 0; }
    [[ "$ans" =~ ^[0-9]+$ ]] || die "нужен номер из списка"
    tag=$(printf '%s\n' "$list" | sed -n "${ans}p" | cut -f1)
    [[ -n "$tag" ]] || die "нет версии под номером $ans"

    if [[ -f "$APPI_DIR/$name.AppImage" ]]; then
        cmd_pin "$name" "$tag"
    else
        # shellcheck disable=SC2086
        if [[ -n "$new_aliases" ]]; then
            cmd_add "$repo@$tag" "$name" -a "$(printf '%s' "$new_aliases" | tr ' ' ',')"
        else
            cmd_add "$repo@$tag" "$name"
        fi
    fi
}

cmd_pin() {
    local name="${1:-}" want="${2:-}" repo cur
    [[ -n "$name" && -n "$want" ]] || die "использование: appi pin <имя> <версия|latest>"
    resolve "$name" >/dev/null
    migrate_meta "$name" || true
    repo=$(meta_get "$name" repo || true)
    [[ -n "$repo" ]] || die "$name: источник не GitHub-репозиторий, закреплять нечего"
    cur=$(meta_get "$name" version || true)

    if [[ "$want" == latest ]]; then
        meta_set "$name" pin latest
        meta_set "$name" source "$repo"
        msg "$name: версия откреплена, беру последний релиз"
        cmd_up "$name"
        return 0
    fi

    meta_set "$name" pin "$want"
    meta_set "$name" source "$repo@$want"
    if [[ "$cur" == "$want" ]]; then
        msg "$name: уже $want, версия закреплена"
    else
        switch_version "$name" "$want"
        gen_alias_file
        msg "$name: закреплён на $want"
    fi
}

# --- декларативный режим ------------------------------------------------

cmd_sync() {
    local list="" dry=0 update=0 prune=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run) dry=1; shift ;;
            -u|--update)  update=1; shift ;;
            -p|--prune)   prune=1; shift ;;
            -*) die "неизвестный флаг '$1'" ;;
            *) [[ -z "$list" ]] && list="$1" || die "лишний аргумент '$1'"; shift ;;
        esac
    done
    list="${list:-$APPI_LIST}"
    [[ -f "$list" ]] || die "список не найден: $list (создайте его или appi export $list)"

    local pfx=""; [[ $dry -eq 1 ]] && pfx="[dry-run] "
    msg "${pfx}синхронизация с $list"

    local declared="" line name src al a cur want add drop f curver
    while IFS= read -r line <&3 || [[ -n "$line" ]]; do
        line="${line%%#*}"
        # shellcheck disable=SC2086
        set -- $line
        [[ $# -gt 0 ]] || continue

        if [[ $# -eq 1 ]]; then
            src="$1"; al=""
            [[ "$src" == */* ]] || die "строка '$1': одиночное поле должно быть user/repo или URL"
            name=$(derive_name "$src")
        else
            name="$1"; src="$2"; al="${3:-}"
        fi
        declared="${declared:+$declared }$name"

        # 1) установка, если нет
        if [[ ! -f "$APPI_DIR/$name.AppImage" ]]; then
            if [[ $dry -eq 1 ]]; then
                msg "[dry-run] установить $name из $src${al:+ (алиасы: $al)}"
                continue
            fi
            # одно неудавшееся приложение не должно рвать всю синхронизацию
            if [[ -n "$al" ]]; then
                ( cmd_add "$src" "$name" -a "$al" ) || msg "$name: установка не удалась, продолжаю"
            else
                ( cmd_add "$src" "$name" ) || msg "$name: установка не удалась, продолжаю"
            fi
            continue
        fi

        # 2) источник мог измениться в списке
        if [[ "$(meta_get "$name" source || true)" != "$src" ]]; then
            if [[ $dry -eq 1 ]]; then
                msg "[dry-run] $name: источник -> $src"
            else
                meta_set "$name" source "$src"
                msg "$name: источник обновлён на $src"
            fi
        fi

        # 2a) версия из списка: user/repo@тег закрепляем, без тега — latest
        if [[ "$src" != http?(s)://* && "$src" == */* ]]; then
            split_src "$src"
            if [[ $dry -eq 0 ]]; then
                meta_set "$name" repo "$SRC_REPO"
                meta_set "$name" pin "$SRC_PIN"
            fi
            curver=$(meta_get "$name" version || true)
            if [[ "$SRC_PIN" != latest && "$SRC_PIN" != "$curver" ]]; then
                if [[ $dry -eq 1 ]]; then
                    msg "[dry-run] $name: версия ${curver:-?} -> $SRC_PIN"
                else
                    ( switch_version "$name" "$SRC_PIN" ) \
                        || msg "$name: не смог поставить $SRC_PIN, продолжаю"
                fi
            fi
        fi

        # 3) алиасы ровно такие, как в списке
        want="${al//,/ }"; cur=$(aliases_of "$name"); add=""; drop=""
        for a in $want; do [[ " $cur " == *" $a "* ]] || add="${add:+$add }$a"; done
        for a in $cur;  do [[ " $want " == *" $a "* ]] || drop="${drop:+$drop }$a"; done
        if [[ -n "$add" || -n "$drop" ]]; then
            if [[ $dry -eq 1 ]]; then
                msg "[dry-run] $name: алиасы${add:+ +$add}${drop:+ -$drop}"
            else
                # shellcheck disable=SC2086
                [[ -n "$drop" ]] && alias_del $drop
                # shellcheck disable=SC2086
                [[ -n "$add" ]] && alias_add "$name" $add
            fi
        fi
    done 3< "$list"

    # 4) обновление всего заявленного
    if [[ $update -eq 1 && -n "$declared" ]]; then
        if [[ $dry -eq 1 ]]; then
            msg "[dry-run] обновить: $declared"
        else
            # shellcheck disable=SC2086
            cmd_up $declared
        fi
    fi

    # 5) лишнее
    for f in "$APPI_DIR"/*.AppImage; do
        name=$(basename "$f" .AppImage)
        [[ " $declared " == *" $name "* ]] && continue
        if [[ $prune -eq 1 ]]; then
            [[ $dry -eq 1 ]] && msg "[dry-run] удалить $name" || cmd_rm "$name"
        else
            msg "$name не в списке (appi sync --prune чтобы удалить)"
        fi
    done

    [[ $dry -eq 1 ]] || { relink_all; msg "синхронизация завершена"; }
}

cmd_export() {
    local out="${1:-}" f name src al repo pin ver
    {
        printf '# appi: имя  источник[@версия]  алиасы (appi sync)\n'
        for f in "$APPI_DIR"/*.AppImage; do
            name=$(basename "$f" .AppImage)
            src=$(meta_get "$name" source || meta_get "$name" url || echo '?')
            repo=$(meta_get "$name" repo 2>/dev/null || true)
            pin=$(meta_get "$name" pin 2>/dev/null || true)
            ver=$(meta_get "$name" version 2>/dev/null || true)
            if [[ -n "$repo" ]]; then
                if [[ -n "$pin" && "$pin" != latest && "$pin" != - ]]; then
                    src="$repo@$pin"
                else
                    src="$repo"
                fi
            fi
            al=$(aliases_of "$name" | tr ' ' ',')
            printf '%-20s %-50s %-20s%s\n' "$name" "$src" "$al" \
                "${ver:+  # установлено: $ver}"
        done
    } > "${out:-/dev/stdout}"
    [[ -n "$out" ]] && msg "список записан в $out"
    return 0
}

cmd_info() {
    local name="${1:-}"; [[ -n "$name" ]] || die "укажите имя"
    resolve "$name" >/dev/null
    cat "$APPI_DIR/$name.meta"
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; }

case "${1:-}" in
    add|i|install) shift; cmd_add "$@" ;;
    ls|list)       shift; cmd_ls "$@" ;;
    up|update)     shift; cmd_up "$@" ;;
    rm|remove)     shift; cmd_rm "$@" ;;
    run)           shift; cmd_run "$@" ;;
    info)          shift; cmd_info "$@" ;;
    alias|ln)      shift; cmd_alias "$@" ;;
    unalias)       shift; cmd_unalias "$@" ;;
    shellrc)       shift; cmd_shellrc "$@" ;;
    relink)        shift; cmd_relink "$@" ;;
    versions|ver)  shift; cmd_versions "$@" ;;
    pick)          shift; cmd_pick "$@" ;;
    pin)           shift; cmd_pin "$@" ;;
    sync)          shift; cmd_sync "$@" ;;
    export)        shift; cmd_export "$@" ;;
    ""|-h|--help)  usage ;;
    *)             die "неизвестная команда '${1}' (appi --help)" ;;
esac

